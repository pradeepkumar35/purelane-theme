{{ 'purelane.css' | asset_url | stylesheet_tag }}
{% comment %}
  Purelane Why Bundles (#whybundles)
  Mirrors the prototype: a glass panel with kicker + heading then a
  4-up grid (2 cols mobile, 4 cols desktop) of bundle benefits.
  Each block picks one of four icons.
{% endcomment %}

<section
  id='whybundles'
  class='purelane-why'
  data-section-id='{{ section.id }}'
  data-purelane-anchor='whybundles'
>
  <div class='purelane-why__inner'>
    <div class='purelane-why__panel glass rv'>
      <div class='purelane-why__head'>
        {% if section.settings.kicker != blank %}
          <span class='purelane-why__kicker'>{{ section.settings.kicker }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class='purelane-why__heading'>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      <div class='purelane-why__grid'>
        {% for block in section.blocks %}
          <div class='purelane-why__item' {{ block.shopify_attributes }}>
            <span class='purelane-why__icon' aria-hidden='true'>
              {% case block.settings.icon %}
                {% when 'percent' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg>
                {% when 'check' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg>
                {% when 'star' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg>
                {% when 'truck' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg>
              {% endcase %}
            </span>
            <h4 class='purelane-why__title'>{{ block.settings.title }}</h4>
            <p class='purelane-why__body'>{{ block.settings.body }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<script src='{{ 'purelane-reveal.js' | asset_url }}' defer='defer'></script>
{% schema %}
{
  "name": "Purelane Why Bundles",
  "tag": "section",
  "class": "purelane-why-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "percent", "label": "Save" },
            { "value": "check", "label": "Flat price" },
            { "value": "star", "label": "Curated" },
            { "value": "truck", "label": "Free shipping" }
          ],
          "default": "percent"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Save up to 45%"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "Versus buying the same products separately"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Why Bundles",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "percent", "title": "Save up to 45%", "body": "Versus buying the same products separately" } },
        { "type": "benefit", "settings": { "icon": "check", "title": "One flat price", "body": "No calculators, no comparing carts" } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Curated by experts", "body": "Products picked to work well together" } },
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free shipping always", "body": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}