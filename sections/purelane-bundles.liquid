{{ 'purelane.css' | asset_url | stylesheet_tag }}
{% comment %}
  Purelane Bundles
  Mirrors the prototype's #bundles section: three flat-price tiers
  (Starter / Most popular / Whole home). "Build this box" opens the
  shared Purelane bundle picker pre-configured for that tier.

  Each tier block carries the flat price + compare price + the tier
  product (whose variant is added to cart with properties[Pick N]).
{% endcomment %}

{% assign pool_collection = collections[section.settings.collection] %}

<section
  id='PurelaneBundles-{{ section.id }}'
  class='purelane-bundles'
  data-purelane-bundles
  data-section-id='{{ section.id }}'
>
  <div class='purelane-bundles__inner'>
    <div class='purelane-bundles__head glass'>
      {% if section.settings.kicker != blank %}
        <span class='purelane-bundles__kicker'>{{ section.settings.kicker }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class='purelane-bundles__heading'>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.lede != blank %}
        <p class='purelane-bundles__lede'>{{ section.settings.lede }}</p>
      {% endif %}
    </div>

    <div class='purelane-tiers'>
      {% for block in section.blocks %}
        {% assign tp = block.settings.product %}
        <article
          class='purelane-tier glass rv rv-d{{ forloop.index }}'
          data-purelane-tier
          data-count='{{ block.settings.qty }}'
          data-variant-id='{% if tp != blank and tp.variants.size > 0 %}{{ tp.variants.first.id }}{% endif %}'
        >
          <span class='purelane-tier__tag'>{{ block.settings.tag }}</span>

          {% if block.settings.image != blank %}
            <div class='purelane-tier__pix' aria-hidden='true'>
              {{
                block.settings.image
                | image_url: width: 300
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 300',
                  sizes: '(min-width: 860px) 260px, 140px',
                  alt: block.settings.tag
              }}
            </div>
          {% else %}
            <div class='purelane-tier__pix' aria-hidden='true'>
              <span class='purelane-tier__icon'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              </span>
            </div>
          {% endif %}

          <div class='purelane-tier__qty'>{{ block.settings.qty }}<small>Products</small></div>

          <div class='purelane-tier__price'>
            {% if block.settings.price != blank %}<strong>{{ block.settings.price }}</strong>{% endif %}
            {% if block.settings.compare != blank %}<s>{{ block.settings.compare }}</s>{% endif %}
          </div>

          {% if block.settings.per_product != blank %}
            <p class='purelane-tier__per'>{{ block.settings.per_product }}</p>
          {% endif %}

          {% if block.settings.features != blank %}
            <ul class='purelane-tier__features'>
              {% assign feats = block.settings.features | newline_to_br | split: '<br />' %}
              {% for f in feats %}
                {% assign ftrim = f | strip %}
                {% if ftrim != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    {{ ftrim }}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}

          <button
            type='button'
            class='purelane-tier__cta {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}'
            data-picker-open
          >
            {{ block.settings.cta_label }}
            {% if block.settings.is_best %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {% endif %}
          </button>
        </article>
      {% endfor %}
    </div>

    {% render 'purelane-bundle-picker',
      picker_section_id: section.id,
      pool_collection: pool_collection
    %}
  </div>
</section>
<script src='{{ 'purelane-reveal.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Picker collection",
      "info": "Products shown in the bundle picker. Defaults to the 'Shop' collection."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product",
          "info": "This product is added to the cart when a box is built."
        },
        {
          "type": "number",
          "id": "qty",
          "label": "Products in box",
          "default": 2
        },
        {
          "type": "text",
          "id": "price",
          "label": "Flat price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare",
          "label": "Compare-at price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product",
          "label": "Per-product note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features (one per line)",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Decorative image (optional)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Highlight as most popular",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "qty": 2,
            "price": "₹349",
            "compare": "₹598",
            "per_product": "Flat ₹174 per product",
            "features": "Pick any two products\nFree shipping across India",
            "cta_label": "Build this box"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "qty": 3,
            "price": "₹499",
            "compare": "₹897",
            "per_product": "Flat ₹166 per product",
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "cta_label": "Build this box",
            "is_best": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "qty": 5,
            "price": "₹799",
            "compare": "₹1495",
            "per_product": "Flat ₹160 per product",
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India",
            "cta_label": "Build this box"
          }
        }
      ]
    }
  ]
}
{% endschema %}
