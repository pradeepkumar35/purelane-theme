{{ 'purelane.css' | asset_url | stylesheet_tag }}
{% comment %}
  Purelane Hero
  First implementation:
  - Merchant-editable hero copy and CTAs
  - Promise blocks
  - Product-based hero slides
{% endcomment %}

<section
  id='PurelaneHero-{{ section.id }}'
  class='purelane-hero'
  data-purelane-hero
  data-section-id='{{ section.id }}'
>
  <div class='purelane-hero__inner'>
    <div class='purelane-hero__copy'>
      <h1>
        <span class='purelane-hero__heading-line'>
          {{ section.settings.heading_line_1 }}
        </span>
        <span class='purelane-hero__heading-line'>
          {{ section.settings.heading_line_2 }}
        </span>
        <span class='purelane-hero__heading-line purelane-hero__heading-accent'>
          {{ section.settings.heading_accent }}
        </span>
      </h1>
      <div class='purelane-hero__rule' aria-hidden='true'>
        <span></span>
        <svg
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.6'
          stroke-linecap='round'
          stroke-linejoin='round'
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <span></span>
      </div>

      {% if section.settings.description != blank %}
        <div class='purelane-hero__description'>
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class='purelane-hero__actions'>
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a href='{{ section.settings.primary_link }}'>
            {{ section.settings.primary_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank
          and section.settings.secondary_link != blank
        %}
          <a href='{{ section.settings.secondary_link }}'>
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class='purelane-hero__promises' aria-label='Product promises'>
      {% for block in section.blocks %}
        {% if block.type == 'promise' %}
          <div
            class='purelane-hero__promise'
            {{ block.shopify_attributes }}
          >
            <span class='purelane-hero__promise-icon' aria-hidden='true'>
              {% case forloop.index %}
                {% when 1 %}
                  <svg
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.6'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  >
                    <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                    <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                  </svg>

                {% when 2 %}
                  <svg
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.6'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  >
                    <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                    <path d="m9 12 2.2 2.2L15.4 10"/>
                  </svg>

                {% when 3 %}
                  <svg
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.6'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  >
                    <circle cx="12" cy="12" r="8.4"/>
                    <path d="M6.4 17.6 17.6 6.4"/>
                  </svg>
              {% endcase %}
            </span>

            <span>{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class='purelane-hero__badgestrip' aria-label='Product promises'>
      {% for block in section.blocks %}
        {% if block.type == 'promise' %}
          <div
            class='purelane-hero__badge'
            {{ block.shopify_attributes }}
          >
            <span class='purelane-hero__badge-icon' aria-hidden='true'>
              {% case forloop.index %}
                {% when 1 %}
                  <svg
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.6'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  >
                    <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                    <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                  </svg>

                {% when 2 %}
                  <svg
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.6'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  >
                    <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                    <path d="m9 12 2.2 2.2L15.4 10"/>
                  </svg>

                {% when 3 %}
                  <svg
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.6'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  >
                    <circle cx="12" cy="12" r="8.4"/>
                    <path d="M6.4 17.6 17.6 6.4"/>
                  </svg>
              {% endcase %}
            </span>

            <span>{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class='purelane-hero__slides'>
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <article
            class='purelane-hero__slide products-count-{{ block.settings.products.size }}'
            {{ block.shopify_attributes }}
          >
            {% if block.settings.label != blank %}
              <div class='purelane-hero__offer'>
                <span class='purelane-hero__offer-label'>
                  {{ block.settings.label }}
                </span>

                {% assign primary_product = block.settings.products | first %}

                {% if primary_product %}
                  <span class='purelane-hero__offer-price'>
                    <strong>{{ primary_product.price | money }}</strong>

                    {% if primary_product.compare_at_price > primary_product.price %}
                      <s>{{ primary_product.compare_at_price | money }}</s>
                    {% endif %}
                  </span>

                  {% if primary_product.compare_at_price > primary_product.price %}
                    {% assign discount = primary_product.compare_at_price
                      | minus: primary_product.price
                    %}
                    <span class='purelane-hero__offer-save'> Save {{ discount | money }} </span>
                  {% endif %}
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.products != blank %}
              <div class='purelane-hero__products'>
                {% for product in block.settings.products %}
                  <a href='{{ product.url }}'>
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '240, 360, 540, 720',
                          sizes: '(min-width: 990px) 40vw, 90vw',
                          alt: product.featured_image.alt
                        | default: product.title
                      }}
                    {% endif %}

                    <span>{{ product.title }}</span>
                    <span>{{ product.price | money }}</span>
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <div class='purelane-hero__dots' role='tablist' aria-label='Hero offers'>
      {% assign slide_index = 0 %}

      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <button
            type='button'
            class='purelane-hero__dot{% if slide_index == 0 %} is-active{% endif %}'
            role='tab'
            aria-selected='{% if slide_index == 0 %}true{% else %}false{% endif %}'
            aria-label='Show offer {{ slide_index | plus: 1 }}'
            data-hero-slide='{{ slide_index }}'
          ></button>

          {% assign slide_index = slide_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
<script src='{{ 'purelane-hero.js' | asset_url }}' defer='defer'></script>
{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Clean"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "That"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Promise",
          "default": "Plant powered"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Hero slide",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Offer label",
          "default": "Single bottle"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 3
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        {
          "type": "promise",
          "settings": {
            "text": "Plant powered"
          }
        },
        {
          "type": "promise",
          "settings": {
            "text": "Safe for kids & pets"
          }
        },
        {
          "type": "promise",
          "settings": {
            "text": "Zero harsh chemicals"
          }
        },
        {
          "type": "slide",
          "settings": {
            "label": "Single bottle"
          }
        },
        {
          "type": "slide",
          "settings": {
            "label": "Any 2 products"
          }
        },
        {
          "type": "slide",
          "settings": {
            "label": "Any 3 products"
          }
        }
      ]
    }
  ]
}
{% endschema %}
