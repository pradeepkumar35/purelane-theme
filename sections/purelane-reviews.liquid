{{ 'purelane.css' | asset_url | stylesheet_tag }}
{% comment %}
  Purelane Reviews
  Mirrors the prototype's #reviews section: a kicker + aggregate badges
  followed by an auto-scrolling marquee of glass review cards. Each card
  is duplicated in the track so the -50% loop is seamless; the rail
  pauses on hover / focus, and animation is disabled under
  prefers-reduced-motion.
{% endcomment %}

{% assign review_count = section.blocks | size %}

<section
  id='voices'
  class='purelane-reviews'
  data-purelane-reviews
  data-scene='1'
  data-section-id='{{ section.id }}'
  data-purelane-anchor='voices'
>
  <div class='purelane-reviews__inner'>
    <div class='purelane-reviews__head rv'>
      {% if section.settings.kicker != blank %}
        <span class='purelane-reviews__kicker'>{{ section.settings.kicker }}</span>
      {% endif %}
      <div class='purelane-reviews__aggs'>
        {% if section.settings.agg_1_label != blank %}
          <span class='purelane-reviews__agg'>
            <span class='purelane-reviews__stars' aria-hidden='true'>★★★★★</span>
            <b>{{ section.settings.agg_1_value }}</b>
            {{ section.settings.agg_1_label }}
          </span>
        {% endif %}
        {% if section.settings.agg_2_label != blank %}
          <span class='purelane-reviews__agg'>
            {{ section.settings.agg_2_prefix }}
            <b>{{ section.settings.agg_2_value }}</b>
            {{ section.settings.agg_2_label }}
          </span>
        {% endif %}
      </div>
    </div>
  </div>

  <div class='purelane-reviews__rail rv' role='region' aria-label='Customer reviews'>
    <div class='purelane-reviews__track' data-reviews-track>
      {% if review_count > 0 %}
        {% for i in (1..2) %}
          {% for block in section.blocks %}
            <article class='purelane-reviews__card glass'>
              <div class='purelane-reviews__stars' aria-label='5 out of 5 stars'>★★★★★</div>
              {% if block.settings.title != blank %}
                <h5 class='purelane-reviews__title'>{{ block.settings.title }}</h5>
              {% endif %}
              {% if block.settings.body != blank %}
                <p class='purelane-reviews__body'>{{ block.settings.body }}</p>
              {% endif %}
              <div class='purelane-reviews__who'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                {% if block.settings.name != blank %}<b>{{ block.settings.name }}</b>{% endif %}
                {% if block.settings.product != blank %}<span>· {{ block.settings.product }}</span>{% endif %}
              </div>
            </article>
          {% endfor %}
        {% endfor %}
      {% else %}
        <article class='purelane-reviews__card glass'>
          <div class='purelane-reviews__stars' aria-label='5 out of 5 stars'>★★★★★</div>
          <h5 class='purelane-reviews__title'>Works like a charm</h5>
          <p class='purelane-reviews__body'>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
          <div class='purelane-reviews__who'>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
            <b>Anita</b><span>· Laundry detergent</span>
          </div>
        </article>
      {% endif %}
    </div>
  </div>
</section>
<script src='{{ 'purelane-reveal.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "agg_1_value",
      "label": "First aggregate value",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "agg_1_label",
      "label": "First aggregate label",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "agg_2_prefix",
      "label": "Second aggregate prefix",
      "default": "Loved by"
    },
    {
      "type": "text",
      "id": "agg_2_value",
      "label": "Second aggregate value",
      "default": "12 lakh+"
    },
    {
      "type": "text",
      "id": "agg_2_label",
      "label": "Second aggregate label",
      "default": "homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "name": "Anita", "product": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "name": "Priya", "product": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "name": "Sunita", "product": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "name": "Rohit S.", "product": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "name": "Verified buyer", "product": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}