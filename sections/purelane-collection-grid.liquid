{{ 'purelane.css' | asset_url | stylesheet_tag }}
{% comment %}
  Purelane Collection Grid
  Mirrors the homepage #shop grid (purelane-shop) but renders the current
  collection's products using the purelane-product-card format. Products
  tagged `purelane-bundle` are skipped so the grid matches the homepage
  shop section exactly.
{% endcomment %}

<section class='purelane-collection-grid' data-purelane-collection-grid data-section-id='{{ section.id }}'>
  <div class='purelane-shop__inner'>
    <div class='purelane-shop__head'>
      {% if section.settings.kicker != blank %}
        <span class='purelane-shop__kicker'>{{ section.settings.kicker }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class='purelane-shop__heading'>{{ section.settings.heading }}</h2>
      {% endif %}

      <div class='purelane-shop__rule' aria-hidden='true'>
        <span></span>
        <svg
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.6'
          stroke-linecap='round'
          stroke-linejoin='round'
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <span></span>
      </div>
    </div>

    <div class='purelane-shelf'>
      {% assign card_index = 0 %}
      {% for product in collection.products %}
        {% if product.tags contains 'purelane-bundle' %}
          {% continue %}
        {% endif %}
        {% assign card_index = card_index | plus: 1 %}
        {% render 'purelane-product-card',
          product: product,
          cta_behavior: 'add',
          cta_label: section.settings.cta_label,
          delay: card_index
        %}
      {% endfor %}
    </div>
  </div>
</section>
<script src='{{ 'purelane-reveal.js' | asset_url }}' defer='defer'></script>
<script src='{{ 'product-form.js' | asset_url }}' defer='defer'></script>
{% schema %}
{
  "name": "Purelane Collection Grid",
  "tag": "section",
  "class": "purelane-collection-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All products"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Add to cart"
    }
  ],
  "presets": [
    {
      "name": "Purelane Collection Grid"
    }
  ]
}
{% endschema %}